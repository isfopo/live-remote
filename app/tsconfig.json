{
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "extends": "@tsconfig/svelte/tsconfig.json",

  "include": [
    "src/**/*",
    "src/**/*.svelte",
    "global.d.ts",
    "main.ts",
    "src/svelte.d.ts"
  ],
  "exclude": ["node_modules/*", "__sapper__/*", "public/*"]
}
